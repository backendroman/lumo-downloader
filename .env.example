APP_NAME=Lumo

# job-* dirs here are wiped on startup
DOWNLOAD_DIR=data/downloads
FILE_TTL_SECONDS=3600
MIN_FREE_DISK_MB=1024

MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUED_JOBS=8
MAX_ACTIVE_JOBS_PER_SESSION=2
MAX_CONCURRENT_ANALYSES=4
MAX_FILESIZE_MB=2048
MAX_DURATION_SECONDS=14400
ANALYZE_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=1800
ANALYSIS_TTL_SECONDS=1800

# per IP
ANALYZE_RATE_PER_MINUTE=15
JOBS_RATE_PER_HOUR=30

# empty = from PATH
FFMPEG_LOCATION=
# e.g. socks5://127.0.0.1:1080
YTDLP_PROXY=

# true behind https
COOKIE_SECURE=false
LOG_LEVEL=INFO

# disables SSRF checks, dev only
ALLOW_PRIVATE_NETWORKS=false
